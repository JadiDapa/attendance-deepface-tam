# Wajib sama persis dengan FACE_API_SECRET di .env Next.js
FACE_API_SECRET=""

# Jarak (cosine distance) maksimal supaya dianggap wajah yang sama.
# Harus sama dengan FACE_MATCH_THRESHOLD di .env Next.js kalau kamu ingin
# logic tampil konsisten (nilai match di sini yang jadi acuan sebenarnya).
# NOTE: dikalibrasi untuk deepface/ArcFace, belum diuji ulang untuk
# insightface/buffalo_l (model beda) — lihat NOTE di main.py.
FACE_MATCH_THRESHOLD="0.68"

# Anti-spoofing (deteksi foto-dari-foto/video) di endpoint /verify. Set "false"
# hanya untuk debug — sebaiknya tetap "true" di produksi supaya absen tidak
# bisa ditipu pakai foto orang lain di layar HP.
# NOTE: backend ONNX/insightface di servis ini belum punya liveness check
# sungguhan — lihat NOTE di main.py.
FACE_ANTI_SPOOFING="true"
