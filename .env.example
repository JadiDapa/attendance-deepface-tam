# Wajib sama persis dengan FACE_API_SECRET di .env Next.js
FACE_API_SECRET=""

# Jarak (cosine distance) maksimal supaya dianggap wajah yang sama.
# Harus sama dengan FACE_MATCH_THRESHOLD di .env Next.js kalau kamu ingin
# logic tampil konsisten (nilai match di sini yang jadi acuan sebenarnya).
FACE_MATCH_THRESHOLD="0.68"

# Backend deteksi wajah DeepFace. "retinaface" akurat tapi lebih berat;
# ganti ke "opencv" kalau server terbatas (akurasi sedikit turun).
FACE_DETECTOR_BACKEND="retinaface"
